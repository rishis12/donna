# Server Security (generate your own for production)
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-bytes-long

# Database (SQLite by default, can use PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# ===========================================
# GEMINI API (Required for AI features)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# GROQ API (Optional - for Whisper audio transcription fallback)
# ===========================================
GROQ_API_KEY=your-groq-api-key-here

# ===========================================
# GOOGLE OAUTH (for Calendar/Gmail)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ===========================================
# MICROSOFT OAUTH (Optional - for Outlook)
# Set up at: https://portal.azure.com/
# ===========================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
