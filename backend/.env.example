# ===========================================
# DONNA AI BACKEND - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Generate secure keys: python -c "import secrets; print(secrets.token_hex(32))"

# ===========================================
# SERVER SECURITY (Required)
# ===========================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-bytes-long

# ===========================================
# DATABASE
# ===========================================
# SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# PostgreSQL (production - Render, Railway, etc.):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ===========================================
# GEMINI API (Required for AI features)
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# GROQ API (Optional - for Whisper audio transcription fallback)
# ===========================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ===========================================
# GOOGLE OAUTH (Required for Calendar/Gmail)
# ===========================================
# Set up at: https://console.cloud.google.com
# Enable: Google Calendar API, Gmail API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ===========================================
# MICROSOFT OAUTH (Optional - for Outlook/Teams)
# ===========================================
# Set up at: https://portal.azure.com
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# ===========================================
# SLACK OAUTH (Optional - for Slack messages)
# ===========================================
# Set up at: https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback

# Optional: For webhook/bot integrations
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ===========================================
# OPTIONAL SETTINGS
# ===========================================
ENV=development
BASE_URL=http://localhost:8000
