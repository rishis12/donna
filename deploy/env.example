# ============================================
# Donna AI Backend - Environment Variables
# ============================================
# Copy this file to backend/.env and fill in your values

# ============================================
# Database Configuration
# ============================================
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ============================================
# Server Configuration
# ============================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-bytes-long-exactly
BASE_URL=http://localhost:8000
ENV=development

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-jwt-secret-key-same-as-secret-key-or-different
JWT_ALGORITHM=HS256

# ============================================
# Groq API (LLM)
# ============================================
GROQ_API_KEY=your-groq-api-key-here

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# For production, use your actual domain:
# GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ============================================
# Microsoft OAuth
# ============================================
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-value
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# For production:
# MICROSOFT_REDIRECT_URI=https://your-domain.com/auth/microsoft/callback

# ============================================
# Slack OAuth
# ============================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback
# For production (must be HTTPS):
# SLACK_REDIRECT_URI=https://your-domain.com/auth/slack/callback

# Slack Bot Token (optional, for webhook support)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ============================================
# PostgreSQL (for docker-compose)
# ============================================
POSTGRES_USER=donna
POSTGRES_PASSWORD=changeme
POSTGRES_DB=donna_db

